# Development data location. Relative paths are resolved from the server process directory.
MZP_DATA_DIR=./.local-data
HOST=127.0.0.1
PORT=3001

# Required for administrative operations. Set a private 24-128 character URL-safe value.
# Generate one with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
# MZP_ADMIN_TOKEN=

# Frontend-only setting, used by Vite when running apps/web.
VITE_API_URL=http://127.0.0.1:3001

# Comma-separated browser origins allowed to call the local API.
# Add the LAN web URL only when intentionally sharing the app on a trusted network.
MZP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
